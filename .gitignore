# ===================== SECRETS — NEVER COMMIT =====================
**/.env
.env
*.env
gmail_sa.json
colt-bots-*.json
*_sa.json
service-account*.json
*credential*.json
*token*.txt

# ===================== generated / large / local =====================
shodan-out/
*.pptx
*.tgz
*.zip
__pycache__/
*.pyc
uploads/
*.bak
*.bak2
*.bak3
node_modules/

# ===================== OpenTofu / Terraform =====================
.terraform/
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars
!*.tfvars.example

# --- hygiene (added automatically) ---
venv/
linkedin_cookies.json
debug_no_results_*.html
*.sarif
results.sarif
*.pdf
feranicus/
jobhuntwow.com/
.portal_url

# golive one-time secrets (NEVER commit)
golive.secrets.env
.golive.env
linkedin_video/frames/
_vidcheck/
docs/_check/
docs/*.pdf
jobhuntwow-app/
docs/*.tmp
docs/.~lock*

# i18n derived artifacts — regenerated by `node webapp/frontend/tools/i18n_catalogue.mjs` on every
# ship. Committing them would create a second source of truth that drifts from the locale files.
webapp/frontend/tools/catalogue.json
webapp/frontend/tools/gap.*.json
webapp/frontend/ssrtmp/

# Forensic bundles: host inventory, IPs, log excerpts. Diagnostic output, never source.
forensics-*.txt

# TOTP seed for the governance gate. A shared secret — never in git.
.govern_totp

# The preview/ship UI stamps describe THIS machine, not the repo.
.ui-preview-stamp
.ui-shipped-hash

# LibreOffice / MS Office lock + owner files, ANYWHERE (line 54 only covers docs/).
# One of these was committed by `git add -A` while a deck was open, then vanished when the app
# closed, leaving a tracked path that does not exist.
.~lock.*#
~$*

# Runtime credential store. Created by user_store.py when USER_DB is unset (e.g. a local test
# run). A user database must never be in git, even an empty one.
data/
*.sqlite

# Marketing campaign — GENERATED DATA is personal data (10k LinkedIn connections: names, emails,
# profile URLs) and the send log names who was contacted. Neither belongs in git. The CODE that
# produces them is committed; the data is regenerated from the operator's own Connections.csv.
marketing/campaign/targets.json
marketing/campaign/targets.csv
marketing/campaign/shortlist_*.csv
marketing/campaign/sent.jsonl
marketing/campaign/Connections.csv

# Screen recordings and scratch media dropped into the campaign folder. A 16MB .webm is not source,
# and a filename with spaces breaks git tooling in ways that look like other bugs.
marketing/campaign/*.webm
marketing/campaign/*.mp4
marketing/campaign/*.png
