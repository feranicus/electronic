# Dockerfile.ci — the TOOLCHAIN the gates run in, so "it passed on my machine" and "it passed in
# CI" mean the same thing.
#
# WHY THIS EXISTS. ship.py's do_tests() runs 37 gate scripts across python, node, ruff and pytest.
# Every one of them was written because something reached a customer. If CI re-listed those gates
# in YAML there would be TWO HOMES for "what must pass before we ship" (defect class 32), the newer
# one would always lose, and the drift would be invisible until a deploy. So CI does not re-list
# them: CI runs `python ship.py --test`, the same entry point the operator runs, inside this image.
#
# This repo has paid for eight ships to the rule "green in a Linux sandbox is not evidence about
# his Windows box" (defect class 19). The honest consequence is NOT to test less, it is to pin the
# toolchain somewhere both machines can agree on - which is this file.
#
# MEASURED, not assumed (2026-10-15): do_tests() makes ZERO ssh calls and needs
# python + node + ruff + pytest + py_compile. The node gate tools import only node builtins
# (node:fs, node:path, node:url, node:child_process), so no node_modules are needed to RUN the
# gates - only to build the frontend, which happens in webapp/Dockerfile, not here.
FROM python:3.12-slim

# Node 20 from the distro's own packaging. nodejs+npm only; no build toolchain, because nothing
# here compiles native modules and every extra package is extra attack surface in a container that
# will execute repository code.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git nodejs npm \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Dependencies first, so the layer cache survives a source-only change. requirements.txt is the ONE
# HOME for the app's python dependencies (ship.py's ensure_app_requirements reads the same file);
# this never re-pins anything, it installs exactly what that file says.
COPY webapp/backend/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt \
 && pip install --no-cache-dir ruff pytest \
 && pip install --no-cache-dir shodan mmh3 google-auth requests

# NODE DEPENDENCIES. The comment above used to claim none were needed. That was MEASURED over
# webapp/frontend/tools/*.mjs - which really do import only builtins - and then generalised to
# "the gates", which is a different set: the engine's five deck builders
# (build_findings_deck.js and friends) `require("pptxgenjs")`. CI therefore died with
# MODULE_NOT_FOUND on the first deck the quality gate tried to render. Defect class 35 - the
# denominator was one directory, the conclusion was about all of them.
#
# DERIVED, not hand-listed: `npm ci` installs exactly what the COMMITTED lockfile pins
# (pptxgenjs 4.0.1), so this layer cannot drift from what the engine actually declares, and a new
# dependency arrives here the moment it is added there. Measured across every .js/.mjs a gate
# runs: pptxgenjs is the only non-builtin in the tree.
#
# NODE_PATH rather than a node_modules inside the workspace, because the gate runs against a COPY
# of the checkout and a checkout contains no node_modules. Node consults NODE_PATH for bare
# specifiers like "pptxgenjs", so resolution works from wherever the copy lands. MEASURED both
# ways: without it the require fails with exactly the MODULE_NOT_FOUND CI reported; with it the
# module resolves from an unrelated directory.
COPY hermes-skills/shodan-assessment/package.json \
     hermes-skills/shodan-assessment/package-lock.json \
     /opt/gatedeps/
RUN cd /opt/gatedeps && npm ci --omit=dev --no-audit --no-fund
ENV NODE_PATH=/opt/gatedeps/node_modules

# The gates execute repository code, so they run as a NON-ROOT user. A gate is allowed to read the
# tree and write temp files; it is never allowed to be the most privileged thing in the pipeline.
RUN useradd --create-home --uid 10001 gates
USER gates

# THE GATE'S OWN WORKSPACE. ship.py's test phase is side-effect free with respect to the PRODUCT -
# it deploys nothing - but it is not side-effect free with respect to the working tree: it refreshes
# the git index, it regenerates the SBOM when stale, and several gates build artifacts. Handing it
# a read-only bind mount made it fail on permissions and report that as a finding about the code
# (124 "broken" files that all compiled perfectly). So CI mounts the checkout read-only at /src and
# the gate runs against a copy it owns here. One home for that path, named rather than repeated in
# the workflow's shell.
ENV GATE_WORKDIR=/home/gates/work
RUN mkdir -p /home/gates/work
WORKDIR /home/gates/work

# TESTS MUST NOT REACH THE INTERNET (defect class 18). The suite stubs its own HTTP, and this is
# the belt to that brace: a gate that tries to resolve a name through a proxy that is not there
# fails loudly instead of quietly measuring the live world.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    SHIP_GATES_OFFLINE=1

# No ENTRYPOINT on purpose. The caller names the command, and the only command CI should ever name
# is the orchestrator's own test phase, against a copy of a READ-ONLY checkout:
#     docker run --rm --network none --user 10001:10001 -v "$PWD:/src:ro" <image> \
#       sh -ec 'cp -a /src/. "$GATE_WORKDIR"/ && cd "$GATE_WORKDIR" && python ship.py --test'
